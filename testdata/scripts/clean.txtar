# Test that clean removes the output directory
exec vanity generate
exists dist/foo/index.html

exec vanity clean
! exists dist

# Test that clean is a no-op if directory doesn't exist
exec vanity clean
stderr 'does not exist'

-- .vanity.yml --
domain: go.example.com
modules:
  - name: foo
    repo: https://github.com/example/foo
    subpackages:
      mode: off
